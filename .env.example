# ============================================
# دلال (Dalal) - Environment Variables Example
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets to version control

# ============================================
# CORE SETTINGS
# ============================================
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-one-with-python
DJANGO_SETTINGS_MODULE=dalal_project.settings
PYTHONPATH=/app
PORT=8080

# ============================================
# DATABASE (Production requires PostgreSQL)
# ============================================
# Railway provides DATABASE_URL automatically
# For local development, you can use SQLite (DEBUG=True)
# For custom PostgreSQL:
# DATABASE_URL=postgres://user:password@host:port/dbname

# ============================================
# SECURITY
# ============================================
# Secure SSL redirect in production
SECURE_SSL_REDIRECT=False

# ============================================
# DOMAIN CONFIGURATION
# ============================================
# Custom domain (if you have one)
CUSTOM_DOMAIN=daluailiraq.com

# Railway public domain (auto-set by Railway)
# RAILWAY_PUBLIC_DOMAIN=muqq.up.railway.app

# Additional allowed hosts (comma-separated)
# ALLOWED_HOSTS=example.com,www.example.com

# CSRF trusted origins (comma-separated)
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# ============================================
# SOCIAL AUTHENTICATION - GOOGLE
# ============================================
# Get from: https://console.cloud.google.com/apis/credentials
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=your-google-client-id
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=your-google-client-secret

# ============================================
# SOCIAL AUTHENTICATION - FACEBOOK
# ============================================
# Get from: https://developers.facebook.com/apps
SOCIAL_AUTH_FACEBOOK_KEY=your-facebook-app-id
SOCIAL_AUTH_FACEBOOK_SECRET=your-facebook-app-secret

# ============================================
# REDIS (Optional - for cache and sessions)
# ============================================
# Railway provides REDIS_URL automatically
# For local Redis:
# REDIS_URL=redis://localhost:6379/0

# ============================================
# EMAIL SETTINGS (Optional)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@daluailiraq.com

# ============================================
# SITE SETTINGS
# ============================================
SITE_NAME=دلال
BASE_URL=https://daluailiraq.com

# ============================================
# GUNICORN SETTINGS
# ============================================
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ============================================
# WEBOCKETS (Optional)
# ============================================
USE_WEBSOCKETS=False

# ============================================
# AI ASSISTANT (Optional)
# ============================================
# AI_ENABLED=False
# AI_PROVIDER=openai
# AI_MODEL=gpt-3.5-turbo
# AI_API_KEY=your-openai-api-key
# AI_TIMEOUT=30
# AI_MAX_INPUT=4000
# AI_MAX_OUTPUT=2000
# AI_RATE_LIMIT=60

# ============================================
# AI VOICE (Optional)
# ============================================
# VOICE_ENABLED=False
# VOICE_PROVIDER=openai

# ============================================
# FILE UPLOAD SETTINGS
# ============================================
# Default is 15MB
# DATA_UPLOAD_MAX_MEMORY_SIZE=15728640
# FILE_UPLOAD_MAX_MEMORY_SIZE=15728640
